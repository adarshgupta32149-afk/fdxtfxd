{
  "expo": {
    "name": "Cali",
    "slug": "cali-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.cali.training"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#070B16",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.cali.training"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "backgroundColor": "#070B16"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Cali needs your photos so you can post Shorts and pictures to the feed.",
          "cameraPermission": "Cali uses the camera to record Shorts.",
          "microphonePermission": "Cali uses the microphone to record sound with your Shorts."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cali uses your location to show the local weather and time for your session."
        }
      ],
      "expo-localization"
    ],
    "scheme": "cali",
    "experiments": {
      "typedRoutes": true
    },
    "backgroundColor": "#070B16"
  }
}
